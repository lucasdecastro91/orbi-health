# Copie este arquivo para ".env" no servidor e preencha os valores reais.
# NUNCA commitar o .env de verdade no git — ele fica só no VPS.

# Senha do Postgres dedicado da Evolution API (gere uma forte, ex: openssl rand -hex 24)
POSTGRES_PASSWORD=

# Senha do Redis (gere uma forte, ex: openssl rand -hex 24)
REDIS_PASSWORD=

# Chave de API global da Evolution API — protege todos os endpoints dela.
# Gere uma forte (ex: openssl rand -hex 32) e guarde no Supabase (secret da Edge Function),
# nunca no código do frontend.
EVOLUTION_API_KEY=

# URL pública onde a Evolution API vai responder (o subdomínio que você apontar pro VPS)
EVOLUTION_PUBLIC_URL=https://wpp.orbihealth.com.br

# URL da Edge Function no Supabase que vai receber os webhooks
# (connection-update, qrcode-updated, messages-upsert)
SUPABASE_WEBHOOK_URL=https://SEU_PROJETO.supabase.co/functions/v1/whatsapp-webhook
